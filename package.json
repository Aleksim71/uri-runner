{
  "name": "uri-runner",
  "version": "0.0.0",
  "description": "URI Runner (CLI: uri) — automation tool to reduce dev routine",
  "type": "commonjs",
  "bin": {
    "uri": "bin/uri.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run test/unit test/e2e",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:scenarios": "vitest run test/scenarios",
    "test:cli": "vitest run test/cli",
    "test:audit": "vitest run test/audit.smoke.test.mjs",
    "lint": "node -c src/cli.cjs && node -c src/lib/audit.cjs && node -c src/lib/runbook.cjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1",
    "unzipper": "^0.12.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "vitest": "^2.1.8"
  }
}
